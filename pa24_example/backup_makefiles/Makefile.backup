# Makefile para PA24 Example - MSPM0C1104
# Ruta al SDK (ajusta según tu instalación)
MSPM0_SDK_INSTALL_DIR ?= /home/mr/Documents/mspm-/mspm0-sdk

# Herramientas del compilador
CC = arm-none-eabi-gcc
LNK = arm-none-eabi-gcc
OBJCOPY = arm-none-eabi-objcopy
SIZE = arm-none-eabi-size

# Configuración del proyecto
PROJECT_NAME = pa24_example
SOURCE_FILES = main.c libs/config/ti_msp_dl_config.c startup_mspm0c110x_gcc.c

# Directorios de construcción
BUILD_DIR = build
OBJ_DIR = $(BUILD_DIR)/obj
OUTPUT_DIR = $(BUILD_DIR)/output

# Objetos a compilar (ahora en build/obj/)
OBJECTS = $(addprefix $(OBJ_DIR)/, $(notdir $(SOURCE_FILES:.c=.obj)))
TARGET = $(OUTPUT_DIR)/$(PROJECT_NAME).out
TARGET_HEX = $(OUTPUT_DIR)/$(PROJECT_NAME).hex

# Flags del compilador para MSPM0C1104 con CMSIS
CFLAGS = \
    -DDeviceFamily_MSPM0C110X \
    -D__MSPM0C1104__ \
    -DARM_MATH_CM0 \
    -O2 \
    -mcpu=cortex-m0plus \
    -march=armv6-m \
    -mthumb \
    -std=c99 \
    -mfloat-abi=soft \
    -ffunction-sections \
    -fdata-sections \
    -g \
    -gstrict-dwarf \
    -Wall \
    "-I$(MSPM0_SDK_INSTALL_DIR)/source/third_party/CMSIS/Core/Include" \
    "-I$(MSPM0_SDK_INSTALL_DIR)/source/third_party/CMSIS/DSP/Include" \
    "-I$(MSPM0_SDK_INSTALL_DIR)/source" \
    -I. \
    -Ilibs/config \
    -Ilibs/i2c \
    -Ilibs/display \
    -Ilibs/fonts

# Flags del linker
LFLAGS = \
    "-L$(MSPM0_SDK_INSTALL_DIR)/source/third_party/CMSIS/DSP/lib/gcc/m0p" \
    -l:arm_cortexM0l_math.a \
    "-L$(MSPM0_SDK_INSTALL_DIR)/source/ti/driverlib/lib/gcc/m0p/mspm0g1x0x_g3x0x" \
    -l:driverlib.a \
    "-Wl,-Map,$(OUTPUT_DIR)/$(PROJECT_NAME).map" \
    "-L$(MSPM0_SDK_INSTALL_DIR)/source" \
    -Wl,-T,device_linker.lds \
    -march=armv6-m \
    -mthumb \
    -static \
    -Wl,--gc-sections \
    -lgcc \
    -lc \
    -lm \
    --specs=nano.specs \
    --specs=nosys.specs

# Reglas principales
all: $(BUILD_DIR) $(TARGET) $(TARGET_HEX)
	@echo "Build complete!"
	@$(SIZE) $(TARGET)

# Crear directorios de construcción
$(BUILD_DIR):
	@mkdir -p $(OBJ_DIR)
	@mkdir -p $(OUTPUT_DIR)

# Variable para buscar archivos fuente con VPATH
VPATH = . libs/config libs/i2c libs/display libs/fonts

# Compilar archivos fuente a objetos
$(OBJ_DIR)/%.obj: %.c | $(BUILD_DIR)
	@echo "Compiling $<"
	@$(CC) $(CFLAGS) $< -c -o $@

# Linkear y crear ejecutable
$(TARGET): $(OBJECTS)
	@echo "Linking $@"
	@$(LNK) $(OBJECTS) $(LFLAGS) -o $(TARGET)

# Crear archivo HEX para programar
$(TARGET_HEX): $(TARGET)
	@echo "Creating HEX file"
	@$(OBJCOPY) -O ihex $(TARGET) $(TARGET_HEX)

# Limpiar archivos generados
clean:
	@echo "Cleaning project"
	@rm -rf $(BUILD_DIR)
	@rm -f *.obj *.out *.map *.hex

# PROGRAMACIÓN PRINCIPAL (método verificado que funciona)
flash: $(TARGET_HEX)
	@echo "=== Programando MSPM0C1104 con método verificado ==="
	@echo "Archivo: $(TARGET_HEX)"
	@if [ ! -f "$(TARGET_HEX)" ]; then \
		echo "Error: $(TARGET_HEX) no existe. Ejecuta 'make all' primero."; \
		exit 1; \
	fi
	pyocd flash -t mspm0c1104 --connect under-reset \
		-O pack.debug_sequences.disabled_sequences=ResetSystem,ResetHWReset,ResetCatchSet,ResetProcessor \
		$(TARGET_HEX)
	@echo "=== ✅ Programación completa - PA24 debería estar parpadeando ==="

# PROGRAMACIÓN DE EMERGENCIA (múltiples métodos - para casos problemáticos)
flash-emergency: $(TARGET_HEX)
	@echo "=== Programando MSPM0C1104 con Múltiples Métodos ==="
	@echo "Archivo: $(TARGET_HEX)"
	@if [ ! -f "$(TARGET_HEX)" ]; then \
		echo "Error: $(TARGET_HEX) no existe. Ejecuta 'make all' primero."; \
		exit 1; \
	fi
	@echo "Método 1: Programando con autodetección y borrado sector..."
	-pyocd flash -O frequency=100000 --erase=sector $(TARGET_HEX) || echo "Método 1 falló"
	@echo "Método 2: Programando con target específico, sin reset..."
	-pyocd flash -t mspm0c1104 -O frequency=100000 --no-reset $(TARGET_HEX) || echo "Método 2 falló"
	@echo "Método 3: Programando con autodetección básica..."
	pyocd flash -O frequency=100000 $(TARGET_HEX) || echo "Método 3 falló - usando flash-emergency"
	@echo "Verificando programación..."
	@sleep 1
	-pyocd reset || echo "Reset falló - presiona el botón de reset manualmente"
	@echo "=== ✅ Programación completa - PA24 debería estar parpadeando ==="
	@echo "Si no parpadea, presiona el botón de reset en la placa"

# PROGRAMACIÓN SIMPLE (sin reset automático)
flash-simple: $(TARGET_HEX)
	@echo "=== Programación Simple (requiere reset manual) ==="
	@if [ ! -f "$(TARGET_HEX)" ]; then \
		echo "Error: $(TARGET_HEX) no existe. Ejecuta 'make all' primero."; \
		exit 1; \
	fi
	pyocd flash \
		-t mspm0c1104 \
		$(TARGET_HEX)
	@echo "=== Programación completa - PRESIONA EL BOTÓN DE RESET EN LA PLACA ==="

# PROGRAMACIÓN CON RESET FORZADO
flash-reset: $(TARGET_HEX)
	@echo "=== Programando con Reset Múltiple ==="
	@if [ ! -f "$(TARGET_HEX)" ]; then \
		echo "Error: $(TARGET_HEX) no existe. Ejecuta 'make all' primero."; \
		exit 1; \
	fi
	@echo "Reset inicial..."
	-pyocd reset -t mspm0c1104 || echo "Reset inicial falló (normal)"
	@sleep 1
	@echo "Programando..."
	pyocd flash \
		-t mspm0c1104 \
		--connect under-reset \
		-O reset_type=hw \
		$(TARGET_HEX)
	@echo "Reset final..."
	@sleep 1
	-pyocd reset -t mspm0c1104 || echo "Reset final falló"
	@sleep 1
	@echo "=== ✅ Programación con múltiples resets completa ==="

# Reset manual del microcontrolador
reset:
	@echo "=== Reset del MSPM0C1104 ==="
	-pyocd reset --soft || echo "Reset suave falló, intentando reset normal..."
	@sleep 0.5
	-pyocd reset || echo "pyOCD reset falló - usa el botón físico de reset"

# Información del proyecto
info: $(TARGET)
	@echo "=== Información del Proyecto ==="
	@echo "Proyecto: $(PROJECT_NAME)"
	@echo "Archivos fuente: $(SOURCE_FILES)"
	@echo "Dispositivo: MSPM0C1104"
	@echo ""
	@echo "=== Tamaño del binario ==="
	@$(SIZE) $(TARGET)

# Ayuda
help:
	@echo "=== Makefile para PA24 Example - MSPM0C1104 ==="
	@echo ""
	@echo "Targets principales:"
	@echo "  all           - Compilar proyecto completo"
	@echo "  clean         - Limpiar archivos generados"
	@echo "  flash         - Programar con método verificado (RECOMENDADO) ✅"
	@echo "  flash-emergency - Múltiples métodos para casos problemáticos"
	@echo "  reset         - Reset manual del microcontrolador"
	@echo "  info          - Información del proyecto"
	@echo "  help          - Esta ayuda"
	@echo ""
	@echo "Uso típico:"
	@echo "  make clean && make && make flash"
	@echo ""
	@echo "NOTA: El comando 'make flash' usa el método verificado:"
	@echo "  pyocd flash -t mspm0c1104 --connect under-reset \\"
	@echo "    -O pack.debug_sequences.disabled_sequences=..."

.PHONY: all clean flash flash-simple flash-reset reset info help flash-soft flash-no-reset flash-emergency

# PROGRAMACIÓN ALTERNATIVA CON RESET SUAVE
flash-soft: $(TARGET_HEX)
	@echo "=== Programación con Reset Suave ==="
	@if [ ! -f "$(TARGET_HEX)" ]; then \
		echo "Error: $(TARGET_HEX) no existe. Ejecuta 'make all' primero."; \
		exit 1; \
	fi
	@echo "Programando con reset suave..."
	pyocd flash \
		-t mspm0c1104 \
		-O reset_type=sw \
		-O frequency=500000 \
		$(TARGET_HEX)
	@echo "Reset suave..."
	@sleep 1
	-pyocd reset -t mspm0c1104 --soft || echo "Reset suave falló"
	@echo "=== ✅ Programación con reset suave completa ==="

# PROGRAMACIÓN BÁSICA SIN RESET (MÁS COMPATIBLE)
flash-no-reset: $(TARGET_HEX)
	@echo "=== Programación sin Reset (más compatible) ==="
	@if [ ! -f "$(TARGET_HEX)" ]; then \
		echo "Error: $(TARGET_HEX) no existe. Ejecuta 'make all' primero."; \
		exit 1; \
	fi
	@echo "Programando sin reset automático..."
	pyocd flash \
		-t mspm0c1104 \
		-O frequency=500000 \
		$(TARGET_HEX)
	@echo "=== ✅ Programación completa - PRESIONA EL BOTÓN DE RESET MANUALMENTE ==="

# PROGRAMACIÓN DE EMERGENCIA (configuración más básica)
flash-emergency: $(TARGET_HEX)
	@echo "=== Programación de Emergencia (configuración mínima) ==="
	@if [ ! -f "$(TARGET_HEX)" ]; then \
		echo "Error: $(TARGET_HEX) no existe. Ejecuta 'make all' primero."; \
		exit 1; \
	fi
	@echo "Intentando programación con configuraciones mínimas..."
	@echo "Opción 1: Frecuencia muy baja"
	-pyocd flash -t mspm0c1104 -O frequency=100000 $(TARGET_HEX) || echo "Opción 1 falló"
	@echo "Opción 2: Sin pack específico"
	-pyocd flash -t cortex-m0plus -O frequency=100000 $(TARGET_HEX) || echo "Opción 2 falló"  
	@echo "Opción 3: Solo autodetección"
	-pyocd flash -O frequency=100000 $(TARGET_HEX) || echo "Opción 3 falló"
	@echo "=== Si ninguna opción funcionó, revisa la conexión física ==="
